# Canonical origin used for metadata, sitemap and robots.
# On Vercel this is inferred (production -> the real domain, previews -> their own
# URL, which is also served noindex). Set it explicitly for other hosts.
NEXT_PUBLIC_SITE_URL=https://www.novapulse.co.in

# Runtime database connection. In production use Neon's pooled connection
# string (the hostname contains `-pooler`).
DATABASE_URL=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/novapulse?sslmode=require

# Direct database connection used only by Drizzle commands (migrate, generate,
# and seed). Do not use Neon's pooled URL here: migrations need a direct URL.
DIRECT_DATABASE_URL=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/novapulse?sslmode=require

# Signs admin sessions and the IP HMAC. Generate: openssl rand -base64 32
AUTH_SECRET=

# Protects Vercel's scheduled maintenance endpoint. Generate separately:
# openssl rand -base64 32
CRON_SECRET=

# Optional — lead notification emails via Resend. Omitted, the app still
# captures leads and simply skips the email.
#
# LEAD_NOTIFICATION_TO takes one address or several separated by commas.
# LEAD_NOTIFICATION_FROM must be on a domain verified in Resend — you cannot
# send *from* gmail.com, though you can send *to* it.
RESEND_API_KEY=
LEAD_NOTIFICATION_TO=growth@novapulse.co.in,second-inbox@example.com
LEAD_NOTIFICATION_FROM=Nova Pulse <notifications@novapulse.co.in>

# Required to upload blog cover images from /admin. Created automatically when
# you add a Blob store in the Vercel dashboard (Storage -> Blob -> Connect).
# Without it the admin still works; cover uploads return a 503.
BLOB_READ_WRITE_TOKEN=
